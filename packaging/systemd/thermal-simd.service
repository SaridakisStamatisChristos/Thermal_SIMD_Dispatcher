[Unit]
Description=Thermal SIMD Dispatcher
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/thermal_simd --interval=50 --sandbox-only
ExecStart=/usr/local/bin/thermal_simd --run-forever --interval=50 --metrics-bind=127.0.0.1 --metrics-port=9464
Environment=TSD_LOG_LEVEL=info
Environment=TSD_PREDICTIVE_COEFF_PATH=/etc/thermal-simd/controller_coeffs.json
CapabilityBoundingSet=CAP_PERFMON
AmbientCapabilities=CAP_PERFMON
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
KillSignal=SIGTERM
TimeoutStopSec=10s
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
IPAddressAllow=127.0.0.1
IPAddressAllow=::1
IPAddressDeny=any

# Optional MSR-backed APERF/MPERF telemetry is deliberately not enabled by
# this default unit. Prefer granting the service account read access to the
# required /dev/cpu/*/msr devices. If the host requires a capability instead,
# add CAP_SYS_RAWIO explicitly rather than CAP_SYS_ADMIN.

[Install]
WantedBy=multi-user.target
